# Global security & performance headers for Cloudflare Pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: autoplay=*, fullscreen=*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Immutable edge caching for 88 acoustic grand piano OGG recordings
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Content-Type: audio/ogg

# Immutable edge caching for images and thumbnails
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and PWA manifest
/favicon.webp
  Cache-Control: public, max-age=604800, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/manifest+json

# Hashed production JS and CSS bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and crawl discovery files
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8
