# Global security & performance headers for Cloudflare Pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: autoplay=*, fullscreen=*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://5gvci.com https://3nbf4.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' blob: data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://5gvci.com https://3nbf4.com https://*.cloudflare.com; worker-src 'self' blob: https://3nbf4.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none';

# Immutable edge caching for 88 acoustic grand piano OGG recordings
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Content-Type: audio/ogg

# Immutable edge caching for images and thumbnails
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons and PWA manifest
/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/svg+xml

/favicon.webp
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/webp

/favicon.ico
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/x-icon

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: image/png

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/manifest+json

# Hashed production JS and CSS bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and crawl discovery files
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=utf-8

/feed.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/rss+xml; charset=utf-8

/opensearch.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/opensearchdescription+xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8

# Service Worker for push notifications / ad monetization
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8
