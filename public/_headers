# Global security & permissions headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: autoplay=*

# Long-term edge cache for audio samples (88 OGG notes)
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Long-term edge cache for images and media
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Long-term edge cache for hashed Vite assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate HTML and SEO crawl metadata
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/llms.txt
  Cache-Control: public, max-age=86400, must-revalidate
